# ─── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── Domain URLs ──────────────────────────────────────────────────────────────
# Leave empty for local dev (code defaults to localhost).
# Set in Vercel/Railway dashboards for production.
#
# Production values:
#   NEXT_PUBLIC_SITE_URL=https://thedracor.com
#   NEXT_PUBLIC_PLAY_URL=https://play.thedracor.com
#   NEXT_PUBLIC_ACCOUNT_URL=https://account.thedracor.com
#   NEXT_PUBLIC_DEV_URL=https://dev.thedracor.com
#   NEXT_PUBLIC_GAME_CLIENT_URL=https://game.thedracor.com
#   NEXT_PUBLIC_GAME_SERVER_URL=wss://server.thedracor.com
#
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_PLAY_URL=
NEXT_PUBLIC_ACCOUNT_URL=
NEXT_PUBLIC_DEV_URL=
NEXT_PUBLIC_GAME_CLIENT_URL=
NEXT_PUBLIC_GAME_SERVER_URL=

# ─── Game Client (Vite — VITE_ prefix required) ──────────────────────────────
# These default to localhost in code when empty.
VITE_GAME_SERVER_URL=ws://localhost:2567
VITE_PUBLIC_SITE_URL=http://localhost:3000
VITE_PUBLIC_ACCOUNT_URL=http://localhost:3000/account
VITE_DEFAULT_PLAYER_NAME=Dracor

# ─── Game Server ──────────────────────────────────────────────────────────────
# Comma-separated allowed origins for CORS.
# Empty = allow all (fine for local dev, not for production).
#
# Production value:
#   GAME_SERVER_ALLOWED_ORIGINS=https://thedracor.com,https://play.thedracor.com,https://account.thedracor.com,https://game.thedracor.com,https://dev.thedracor.com
#
GAME_SERVER_ALLOWED_ORIGINS=
PORT=2567
